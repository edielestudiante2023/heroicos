#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost/heroicos/public/'
app.indexPage = ''

#--------------------------------------------------------------------
# DATABASE - LOCAL (XAMPP)
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = heroicos
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# DATABASE - PRODUCCION (DigitalOcean)
#--------------------------------------------------------------------
# Completar con credenciales reales del cluster

database.production.hostname =
database.production.database = heroicos
database.production.username =
database.production.password =
database.production.DBDriver = MySQLi
database.production.DBPrefix =
database.production.port = 25060
database.production.charset = utf8mb4
database.production.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------
# Generar con: php spark key:generate

encryption.key =

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

session.driver = 'CodeIgniter\Session\Handlers\DatabaseHandler'
session.savePath = 'ci_sessions'

#--------------------------------------------------------------------
# SENDGRID (Email transaccional)
#--------------------------------------------------------------------

sendgrid.apiKey =
sendgrid.fromEmail =
sendgrid.fromName = 'Heroicos Futbol Club'
